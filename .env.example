# ============================================================
#  wx-agent 环境变量模板
#  用法：cp .env.example .env  (Windows: copy .env.example .env)
#  注意：.env 已在 .gitignore 中，不会被提交
# ============================================================

# ---------- 企业微信（自建应用）----------
# 管理后台 → 我的企业 → 企业信息 → 企业ID
WECOM_CORP_ID=ww0000000000000000
# 管理后台 → 应用管理 → 自建应用 → AgentId
WECOM_AGENT_ID=1000002
# 管理后台 → 应用管理 → 自建应用 → Secret
WECOM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 应用 → 接收消息 → API接收消息 → Token
WECOM_CALLBACK_TOKEN=your_callback_token
# 应用 → 接收消息 → API接收消息 → EncodingAESKey（必须是 43 位）
WECOM_ENCODING_AES_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 本地服务端口（改了的话内网穿透端口也要跟着改）
WECOM_PORT=3000

# ---------- LLM（任意 OpenAI 兼容接口）----------
# DeepSeek : https://api.deepseek.com/v1              model = deepseek-chat
# 通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1  model = qwen-plus
# 智谱     : https://open.bigmodel.cn/api/paas/v4     model = glm-4-flash
# OpenAI   : https://api.openai.com/v1                model = gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ---------- 可选：Google Scholar（经 SerpAPI 中转）----------
# 只有「查学者」会用到；不配也能跑其余功能。
# 免费额度 100 次/月：https://serpapi.com
# 配置后由 skills/scholar.mjs 从环境变量读取，不会进入模型上下文。
SERPAPI_KEY=
